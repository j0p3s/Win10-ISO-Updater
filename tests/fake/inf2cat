#!/bin/sh
# fake Inf2Cat: /driver:<dir> -> writes every CatalogFile named in the INFs, unsigned
for a in "$@"; do case "$a" in /driver:*) d="${a#/driver:}";; esac; done
for inf in "$d"/*.inf; do
  c=$(grep -i '^ *CatalogFile' "$inf" | head -1 | sed 's/.*= *//; s/[ ;].*//' | tr -d '\r')
  [ -n "$c" ] && printf 'catalog-unsigned' > "$d/$c"
done
echo "Signability test complete."
exit 0
